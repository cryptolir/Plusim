# AgentGlob agent slug
AGENTGLOB_AGENT_NAME=onlyclaw

# AgentGlob app API key — issued by AgentGlob; scopes per-user workspace-file
# section reads to this app. Server-side secret. Leave empty unless used.
AGENTGLOB_APP_API_KEY=
# Separate write key for the AgentGlob raw user-file PUT (admin file edits).
AGENTGLOB_APP_WRITE_KEY=

# Clerk auth — get from https://dashboard.clerk.com -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Postgres connection string
# Dev:  postgresql://plusim:plusim_dev_pass@localhost:5434/plusim  (plusim-postgres-dev Docker container)
# Prod: internal URL from the Coolify Plusim_DB service
DATABASE_URL=

# Admin section (/admin). Comma-separated Clerk-authenticated emails granted admin access.
ADMIN_EMAILS=

# -- Statement-categorization pipeline (docs/REPORTS_PIPELINE.md) ---------------
# Static bearer for the agent-facing /api/agent/* routes. The SAME value is set
# in the AgentGlob workspace secrets as PLUSIM_RUNTIME_TOKEN so the onlyclaw
# plusim-reports skill can authenticate. Generate: openssl rand -base64 32
PLUSIM_AGENT_RUNTIME_TOKEN=
# Absolute base URL used in links handed to the agent (manifest/files/callback).
APP_BASE_URL=https://plusim.xyz

# OpenAI API key — only needed if the optional admin Drive transcript summarizer is enabled.
OPENAI_API_KEY=

# -- Optional: Google Drive admin meeting-transcripts feature -------------------
# Leave unset for Plusim v1; the admin Drive UI stays dormant without these.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://plusim.xyz/admin/api/drive/callback
PLUSIM_DRIVE_ROOT_FOLDER_ID=
DRIVE_TOKEN_ENCRYPTION_KEY=
DRIVE_OAUTH_STATE_SECRET=
