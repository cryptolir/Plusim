datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Conversation {
  id             String    @id @default(cuid())
  userId         String
  sessionKey     String    @unique
  agentName      String
  sectionContext String?
  title          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  messages       Message[]
  view           ConversationView?

  @@index([userId, updatedAt(sort: Desc)])
}

// Per-conversation "last viewed" marker (1:1 with Conversation). Kept in a
// separate table so marking a chat viewed never bumps Conversation.updatedAt
// (which would reorder the recent list). A chat shows as "new" when it has no
// view row or its updatedAt is newer than lastViewedAt.
model ConversationView {
  conversationId String       @id
  lastViewedAt   DateTime
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model Message {
  id                 String       @id @default(cuid())
  conversationId     String
  role               String
  content            String
  agentglobMessageId String?
  createdAt          DateTime     @default(now())
  conversation       Conversation @relation(fields: [conversationId], references: [id])

  @@index([conversationId, createdAt(sort: Asc)])
}

model AppSetting {
  key       String   @id // e.g. "drive_oauth"
  value     String // AES-256-GCM-encrypted JSON (DRIVE_TOKEN_ENCRYPTION_KEY)
  updatedAt DateTime @updatedAt
}

model UserDriveFolder {
  id         String   @id @default(cuid())
  userId     String   @unique // Clerk userId
  folderId   String // a subfolder of PLUSIM_DRIVE_ROOT_FOLDER_ID
  folderName String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Statement-categorization pipeline (admin upload → onlyclaw agent → report).
// Money is stored as agorot integers — never floats. docs/REPORTS_PIPELINE.md.
// ---------------------------------------------------------------------------

model ReportJob {
  id            String    @id @default(cuid())
  targetUserId  String // Clerk userId whose report section shows this job
  createdBy     String // admin email
  status        String    @default("uploaded") // uploaded|dispatched|processing|needs_review|completed|published|failed
  title         String?
  error         String?
  verification  Json? // agent-reported + app-recomputed reconciliation
  sheetUrl      String? // Google Sheets export (set on publish)
  // Per-job bearer for /api/agent/jobs/<id>/* — sha256 hex of the raw token.
  agentTokenHash      String?
  agentTokenExpiresAt DateTime?
  // Queue-dispatch attempt ownership (docs/plans/reports-scaling-stage1-2.md §4):
  //   queueJobId          — pg-boss entry id that claimed this dispatch generation
  //   dispatchAttemptedAt — set immediately before callAgent; splits crashed
  //                         retries into "never sent" (null → safe to re-send)
  //                         vs "ambiguously accepted" (set → never re-send)
  queueJobId          String?
  dispatchAttemptedAt DateTime?
  dispatchedAt  DateTime?
  completedAt   DateTime?
  publishedAt   DateTime?
  // "Ask the agent" adjustment turn (docs/plans/report-adjust-chat.md B1):
  //   adjustTokenHash/ExpiresAt — sha256 of a per-turn token, cleared when the turn ends
  //   adjustGeneration          — dispatchedAt the token was minted for (a re-run voids it)
  //   rowsRevision              — bumped by every applied adjust
  //   artifactRevision          — rowsRevision the stored workbook was built from
  adjustTokenHash      String?
  adjustTokenExpiresAt DateTime?
  adjustGeneration     DateTime?
  rowsRevision         Int       @default(0)
  artifactRevision     Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  files         StatementFile[]
  artifacts     ReportArtifact[]
  transactions  ReportTransaction[]
  settlements   ReportSettlement[]
  chatMessages  ReportChatMessage[]

  @@index([targetUserId, publishedAt(sort: Desc)])
}

// Raw statement bytes live in the client's Google Drive folder (never Postgres),
// reusing the owner-OAuth Drive routine. We keep only the Drive ids + metadata:
//   driveFileId   — the uploaded file
//   driveFolderId — the UserDriveFolder it was written into, so a read can be
//                   re-bound to the job user's folder (not merely the owner root).
model StatementFile {
  id            String    @id @default(cuid())
  jobId         String
  filename      String
  mime          String
  size          Int
  driveFileId   String
  driveFolderId String
  sourceLabel   String? // e.g. "isracard-4962", "max"
  // sha256 hex of the uploaded bytes, set at upload (null on rows from before the
  // column): an identical re-upload to the same job is refused, and a later
  // parse cache can key on it (docs/plans/scale-large-statements.md B2).
  sha256        String?
  createdAt     DateTime  @default(now())
  job           ReportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([jobId, sha256])
}

// The admin's "שיחה עם הסוכן" thread for one job. `generation` is the job's
// dispatchedAt for the turn, so a re-run starts a clean thread and a reply that
// lands after a re-run stays filed under the old one.
model ReportChatMessage {
  id         String    @id @default(cuid())
  jobId      String
  role       String // "user" | "assistant"
  content    String
  actor      String? // admin email for user messages
  generation DateTime
  createdAt  DateTime  @default(now())
  job        ReportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, generation, createdAt])
}

model ReportArtifact {
  id        String    @id @default(cuid())
  jobId     String
  filename  String
  bytes     Bytes
  createdAt DateTime  @default(now())
  job       ReportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}

model ReportTransaction {
  id            String    @id @default(cuid())
  jobId         String
  month         String // "2026-06" — calendar month of the TRANSACTION date
  date          String // ISO "2026-06-14"
  merchant      String
  amountAgorot  Int // negative = refund/credit
  category      String? // taxonomy leaf name; null when uncategorized
  uncategorized Boolean   @default(false)
  sourceLabel   String // which statement/card this came from
  note          String?
  dedupKey      String // parser-computed identity (voucher id or date|merchant|amount)
  // "expense" (card rows, bank debits, refund credits) | "income" (a bank credit in
  // an הכנסות leaf) | "credit" (a bank credit not yet placed). Consumers route
  // income by THIS, never by sign — income and refunds are both negative.
  kind          String    @default("expense")
  createdAt     DateTime  @default(now())
  job           ReportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, month])
}

// A bank debit that paid a credit-card statement (docs/plans/bank-statements.md,
// Decision 3). Never a transaction — its shekels are itemized on the card
// statement — kept so the client can match it against the card's charge cycle.
// Rows are replaced with the transactions on every result callback, so a match
// does not survive a re-run (B3 limitation).
model ReportSettlement {
  id           String    @id @default(cuid())
  jobId        String
  month        String
  date         String
  payee        String
  amountAgorot Int // positive
  sourceLabel  String // the bank source
  dedupKey     String
  matchedCycle String? // "<card sourceLabel>@<YYYY-MM-DD>" — the charge cycle it paid
  job          ReportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, month])
}

// Admin-defined category leaves that EXTEND the base REPORT_TAXONOMY constant.
// Merged into the taxonomy at every consumer (agent manifest, result
// verification, admin category validation, the assign picker, the client
// report page) so app and agent still agree on the full leaf set. Add-only in
// v1 — see docs/plans/report-custom-categories.md.
model ReportCategory {
  id        String   @id @default(cuid())
  name      String   @unique // Hebrew leaf name; must not collide with a base leaf
  section   String // one of REPORT_TAXONOMY's section names
  createdBy String // admin email
  createdAt DateTime @default(now())
}

// Learned merchant→category dictionary. Approved rows are included in every
// job manifest so the deterministic pass grows over time.
model MerchantMapping {
  id              String   @id @default(cuid())
  merchantPattern String   @unique // normalized merchant string
  category        String // taxonomy leaf name
  source          String // "admin" | "agent"
  approved        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([approved])
}
